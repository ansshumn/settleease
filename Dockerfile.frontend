# ==========================================
# STAGE 1: Build the React + Vite Application
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# 1. Package files pehle copy karo
COPY package*.json ./
RUN npm install

# 2. Saara frontend config aur source code copy karo
COPY index.html vite.config.ts tsconfig*.json tailwind.config.ts postcss.config.js components.json ./
COPY frontend/ ./frontend/
COPY public/ ./public/

# 3. Production build generate karo (dist folder banega)
RUN npm run build

# ==========================================
# STAGE 2: Lightweight Nginx Web Server
# ==========================================
FROM nginx:alpine

# 1. Built files Nginx html folder mein copy karo
COPY --from=builder /app/dist /usr/share/nginx/html

# 2. Nginx config copy karo
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
